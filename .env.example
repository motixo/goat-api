# Documentation only: the Go application never reads this file directly.
# Export these values through the shell, Devenv, Make, Docker, or your service manager.
ENV=development

# Required PostgreSQL settings.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=goat
# Maximums: connection 1m; migration validation/application, migration command,
# and seed initialization 30m. The application itself performs no schema DDL.
DB_CONNECTION_TIMEOUT=5s
DB_INITIALIZATION_TIMEOUT=2m

GIN_MODE=release
SERVER_PORT=8080
# HTTP ingress bounds. Maximums: read headers 30s, reads 2m, writes 5m,
# idle connections 10m, headers 1 MiB, and request bodies 10 MiB.
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_MAX_HEADER_BYTES=65536
HTTP_MAX_BODY_BYTES=1048576
# Empty means trust no forwarding proxy. When deployed behind a reverse proxy,
# list only its IP addresses or CIDR ranges; universal ranges are rejected.
HTTP_TRUSTED_PROXIES=

# JWT_SECRET is required. Access-token lifetime must be between 1m and 15m.
JWT_SECRET=secret
JWT_EXPIRATION=5m
REFRESH_TOKEN_EXPIRATION=168h
SESSION_EXPIRATION=720h

# Required; replace this example value outside local development.
PASSWORD_PEPPER=pepper
# Argon2id uses 64 MiB and four lanes per operation. Hash and verification
# share this bound; default 2, accepted range 1-4.
PASSWORD_HASH_MAX_CONCURRENCY=2

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# Maximum 1m. This bounds startup validation, not runtime Redis commands.
REDIS_CONNECTION_TIMEOUT=5s

# Boolean values and the compatible numeric forms 0/1 are accepted.
# Production seeding requires explicit non-default credentials and a policy-valid password.
SEED=0
ADMIN_EMAIL=admin@goat.api
ADMIN_PASSWORD=password

# Limits and windows must be positive.
RATE_LIMIT_AUTH_LIMIT=5
RATE_LIMIT_AUTH_WINDOW=1m
RATE_LIMIT_PUBLIC_LIMIT=100
RATE_LIMIT_PUBLIC_WINDOW=1m
RATE_LIMIT_PRIVATE_LIMIT=60
RATE_LIMIT_PRIVATE_WINDOW=1m
